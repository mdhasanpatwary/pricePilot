{
  "name": "price-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:full:clean": "pkill -f \"next dev\" || true; pkill -f \"scripts/start-worker.ts\" || true",
    "dev:full": "yarn run dev:full:clean && prisma generate && concurrently --kill-others-on-fail \"next dev\" \"yarn run worker:dev\"",
    "dev:next": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "prisma generate && next start",
    "lint": "eslint .",
    "worker": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/start-worker.ts",
    "worker:dev": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/start-worker.ts",
    "backup": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/backup-db.ts",
    "retention": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/data-retention.ts",
    "migrate-tokens": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/migrate-tokens.ts",
    "migrate:tokens": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/migrate-api-tokens.ts",
    "migrate:tokens:dry-run": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/migrate-api-tokens.ts --dry-run",
    "migrate:tokens:verify": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/migrate-api-tokens.ts --verify-only",
    "test:encryption": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/test-token-encryption.ts",
    "verify:multi-worker": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/verify-multi-worker-readiness.ts",
    "test:browser-pool": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/test-unified-browser-pool.ts",
    "soak:multi-worker": "bash scripts/run-multi-worker-soak.sh",
    "rotate-keys": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/rotate-keys.ts",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "monitor-cache": "tsx scripts/monitor-cache.ts",
    "test-cache-alerting": "tsx scripts/test-cache-alerting.ts",
    "archival": "tsx scripts/run-archival.ts",
    "validate-docs": "tsx scripts/validate-docs-structure.ts",
    "measure-queries": "tsx scripts/measure-query-performance.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.38.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.4",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.9.2",
    "isomorphic-dompurify": "^2.35.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "prisma": "^7.2.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "rehype-shiki": "^0.0.9",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/string-similarity": "^4.0.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
