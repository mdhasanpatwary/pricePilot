# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# CORS Configuration
# Comma-separated list of allowed origins for API requests
# In production, NEVER use wildcards (*). Specify exact domains.
# Example: ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"

# Super Admin Access
SUPER_ADMIN_LOGIN_CODE="your-admin-code"

# Encryption Configuration
# Generate a new key using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED: 32-byte (256-bit) base64-encoded key for AES-256-GCM encryption
ENCRYPTION_MASTER_KEY=""

# For key rotation, set the new key here temporarily
# ENCRYPTION_MASTER_KEY_NEW=""

# ============================================================================
# Redis Cache Configuration (Upstash)
# ============================================================================
# Get these credentials from your Upstash dashboard:
# 1. Go to: https://console.upstash.com/
# 2. Select your database (or create a new one)
# 3. Navigate to the "REST API" section
# 4. Copy the REST URL and REST TOKEN
#
# Memory Configuration:
# - Recommended memory limit: 500MB
# - Eviction policy: allkeys-lru (Least Recently Used)
# - Configure these settings in your Upstash dashboard under "Configuration"
#
# Performance Targets:
# - Cache hit rate: 70%+
# - Response time: <50ms for cached queries
# - Database load reduction: 60%+
#
# TTL Defaults:
# - Product comparisons: 5 minutes (300s)
# - Product matching: 15 minutes (900s)
# - Competitor products: 30 minutes (1800s)
# - Price history: 1 hour (3600s)
# - Analytics: 10 minutes (600s)
# ============================================================================
# Redis (required for BullMQ queues, caching, monitoring)
REDIS_URL="redis://localhost:6379"
# or for SSL: REDIS_URL="rediss://default:password@host:6379"

# Redis Memory Monitoring Configuration
# These values are used by the monitoring service to track memory usage
# and generate alerts when thresholds are exceeded
# IMPORTANT: Set this to match your Redis maxmemory config (if any)
REDIS_MEMORY_LIMIT_MB=250              # Memory limit in MB
REDIS_MEMORY_ALERT_THRESHOLD=0.8      # Alert when usage exceeds 80%

# ============================================================================
# Cache Alerting Configuration
# ============================================================================
# Enable/disable cache alerting system
CACHE_ALERTING_ENABLED=true

# Alert thresholds
CACHE_HIT_RATE_THRESHOLD=0.6           # Alert when hit rate falls below 60%
CACHE_MEMORY_THRESHOLD=0.8             # Alert when memory usage exceeds 80%
CACHE_RESPONSE_TIME_THRESHOLD=100      # Alert when operations take longer than 100ms

# Notification channels (comma-separated: log,email,slack,webhook)
CACHE_ALERT_CHANNELS=log

# Email notification configuration (if using email channel)
ALERT_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your-smtp-password

# Slack notification configuration (if using slack channel)
SLACK_ALERT_CHANNEL=#alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Webhook notification configuration (if using webhook channel)
ALERT_WEBHOOK_URL=https://your-monitoring-system.com/webhook
# ============================================================================

# Captcha Solver Configuration
CAPTCHA_SOLVER_ENABLED="false"
CAPTCHA_SOLVER_API_KEY=""
CAPTCHA_SOLVER_TIMEOUT="120000"

# Retry Strategy Configuration
RETRY_MAX_ATTEMPTS="3"
RETRY_INITIAL_DELAY="1000"
RETRY_MAX_DELAY="30000"
RETRY_BACKOFF_MULTIPLIER="2"

# ============================================================================
# Sync Service Retry Configuration
# ============================================================================
# Configure retry behavior for external API calls (OpenCart, Laravel, etc.)
# These settings control how the system handles transient failures during
# product synchronization and price updates.
#
# Retry Strategy:
# - Exponential backoff with jitter to prevent thundering herd
# - Only retries transient failures (network errors, 5xx, rate limits)
# - Does not retry client errors (4xx) except 408 and 429
#
# Recommended Settings:
# - Development: 3 retries, 1s initial backoff
# - Production: 3-5 retries, 1-2s initial backoff
# - Rate-limited APIs: 3 retries, 5s initial backoff
# ============================================================================
# Maximum number of retry attempts for sync operations (default: 3)
SYNC_MAX_RETRIES=3

# Initial backoff delay in milliseconds (default: 1000)
SYNC_INITIAL_BACKOFF_MS=1000

# Maximum backoff delay in milliseconds (default: 30000)
SYNC_MAX_BACKOFF_MS=30000
# ============================================================================

# Concurrency Configuration
CONCURRENCY_MIN="1"
CONCURRENCY_MAX="10"
CONCURRENCY_INITIAL="3"

# ============================================================================
# Browser Pool & Scraping Performance Configuration
# ============================================================================
# Controls resource usage during competitor product scraping
# Lower values reduce CPU/Memory usage but slow down scraping
#
# Development Recommendations:
# - BROWSER_POOL_MAX_CONCURRENT="2"
# - SCRAPING_MAX_CONCURRENT_PER_TENANT="2"
# - SCRAPING_ENABLE_WARMUP="false"
# - SCRAPING_ENABLE_SCREENSHOTS="false"
#
# Production Recommendations:
# - BROWSER_POOL_MAX_CONCURRENT="5"
# - SCRAPING_MAX_CONCURRENT_PER_TENANT="5"
# - SCRAPING_ENABLE_WARMUP="true"
# - SCRAPING_ENABLE_SCREENSHOTS="true"
# ============================================================================

# Browser Pool Configuration
BROWSER_POOL_MAX_CONCURRENT="2"           # Max concurrent browser instances (Dev: 2, Prod: 5)
BROWSER_POOL_MAX_REQUESTS="50"            # Max requests per browser before restart
BROWSER_POOL_IDLE_TIMEOUT="180000"        # Browser idle timeout in ms (3 minutes)

# Scraping Performance
SCRAPING_MAX_CONCURRENT_PER_TENANT="2"    # Max concurrent scrapes per tenant (Dev: 2, Prod: 5)
SCRAPING_BATCH_SIZE="20"                  # Max products to scrape in one batch (Dev: 20, Prod: 100)
SCRAPING_ENABLE_WARMUP="false"            # Enable session warmup (homepage visits) - CPU intensive
SCRAPING_ENABLE_SCREENSHOTS="false"       # Enable screenshot capture - Memory intensive
SCRAPING_MIN_DELAY_PER_SITE="2000"        # Minimum delay between requests to same site (ms)

# Alert Thresholds
ALERT_BLOCK_RATE_THRESHOLD="0.3"
ALERT_SOLVE_RATE_THRESHOLD="0.7"
ALERT_PROXY_FAILURE_THRESHOLD="0.5"
ALERT_RESPONSE_TIME_THRESHOLD="5000"

# Cron Job Secret (for scheduled tasks)
# Generate a secure random string for authenticating cron job requests
# Generate: openssl rand -base64 32
CRON_SECRET=""

# Development Mock Mode (set to "true" to use mock data instead of real API calls)
# WARNING: Only use this in development/testing environments
USE_MOCK_DATA="false"

# ============================================================================
# Sentry Configuration (Error Tracking and Performance Monitoring)
# ============================================================================
# Get these credentials from your Sentry dashboard:
# 1. Go to: https://sentry.io/
# 2. Create a new project or select an existing one
# 3. Navigate to Settings > Projects > [Your Project] > Client Keys (DSN)
# 4. Copy the DSN URL
#
# Sentry DSN (Data Source Name) - Required for error tracking
SENTRY_DSN=""

# Environment name (development, staging, production)
SENTRY_ENVIRONMENT="development"

# Release version (optional, helps track errors by version)
# Format: project-name@version (e.g., "pricepilot@1.0.0")
SENTRY_RELEASE=""

# Sample rate for performance monitoring (0.0 to 1.0)
# 1.0 = 100% of transactions, 0.1 = 10% of transactions
# Recommended: 0.1 for production, 1.0 for development
SENTRY_TRACES_SAMPLE_RATE="1.0"

# Enable/disable Sentry error tracking
SENTRY_ENABLED="true"

# Sentry organization slug (for source map uploads)
SENTRY_ORG=""

# Sentry project name (for source map uploads)
SENTRY_PROJECT=""

# Sentry auth token (for source map uploads during build)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=""
# ============================================================================
