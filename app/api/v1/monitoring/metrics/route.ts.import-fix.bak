/**
 * Monitoring Metrics API Endpoint
 * 
 * GET /api/v1/monitoring/metrics
 * 
 * Returns metric history for a specific metric type and time range.
 * 
 * Query Parameters:
 * - metricType: Type of metric (error, response_time, scraping_success, price_update)
 * - startTime: Start of time range (ISO 8601 timestamp)
 * - endTime: End of time range (ISO 8601 timestamp)
 * - granularity: Data granularity (1m, 5m, 15m, 1h, 1d)
 * - tenantId: Optional tenant ID for filtering (super admin only)
 * 
 * Requirements: 6.1, 6.2, 6.3, 6.4, 6.8, 9.5
 * 
 * Authentication: Required (Admin role only)
 */

import { NextRequest, NextResponse } from 'next/server';
import { monitoringDashboardService } from '@/lib/services/monitoring/dashboard';
import { logger } from '@/lib/logger';
import { z } from 'zod';

/**
 * Query parameter validation schema
 */
const metricsQuerySchema = z.object({
    metricType: z.enum([
        'error',
        'response_time',
        'scraping_success',
        'scraping_block',
        'price_update',
        'auth_failure',
        'db_connection',
        'redis_connection',
    ]),
    startTime: z.string().datetime(),
    endTime: z.string().datetime(),
    granularity: z.enum(['1m', '5m', '15m', '1h', '1d']).default('5m'),
    tenantId: z.string().min(1).optional(),
});

/**
 * GET handler for metrics endpoint
 */
async function handleGET(req: NextRequest) {
    try {
        // Check authentication
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'UNAUTHORIZED',
                        message: 'Authentication required',
                    }
                },
                { status: 401 }
            );
        }

        // Check admin role (ADMIN role or super admin)
        const isAdmin = session.user.role === 'ADMIN' || session.user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Admin access required',
                    }
                },
                { status: 403 }
            );
        }

        // Parse and validate query parameters
        const searchParams = req.nextUrl.searchParams;
        const queryParams = {
            metricType: searchParams.get('metricType'),
            startTime: searchParams.get('startTime'),
            endTime: searchParams.get('endTime'),
            granularity: searchParams.get('granularity') || '5m',
            tenantId: searchParams.get('tenantId') || undefined,
        };

        const validationResult = metricsQuerySchema.safeParse(queryParams);

        if (!validationResult.success) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'VALIDATION_ERROR',
                        message: 'Invalid query parameters',
                        details: {
                            fields: validationResult.error.flatten().fieldErrors,
                        },
                    },
                },
                { status: 422 }
            );
        }

        const { metricType, startTime, endTime, granularity, tenantId } = validationResult.data;

        // Only super admins can filter by tenant
        if (tenantId && !session.user.isSuperAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Only super admins can filter by tenant',
                    }
                },
                { status: 403 }
            );
        }

        // Validate time range
        const start = new Date(startTime);
        const end = new Date(endTime);

        if (start >= end) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'VALIDATION_ERROR',
                        message: 'Start time must be before end time',
                    }
                },
                { status: 422 }
            );
        }

        // Limit time range to 30 days
        const maxRangeMs = 30 * 24 * 60 * 60 * 1000; // 30 days
        if (end.getTime() - start.getTime() > maxRangeMs) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'VALIDATION_ERROR',
                        message: 'Time range cannot exceed 30 days',
                    }
                },
                { status: 422 }
            );
        }

        // Get metric history
        const metrics = await monitoringDashboardService.getMetricHistory(
            metricType,
            {
                start,
                end,
                granularity,
            },
            tenantId
        );

        logger.info('Metrics retrieved', {
            userId: session.user.id,
            metricType,
            dataPointCount: metrics.dataPoints.length,
            tenantId,
        });

        return NextResponse.json({
            success: true,
            data: metrics,
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error('Failed to get metrics', {
            error: error instanceof Error ? error.message : String(error),
        });

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: 'INTERNAL_ERROR',
                    message: 'Failed to retrieve metrics',
                    details: error instanceof Error ? error.message : String(error),
                },
            },
            { status: 500 }
        );
    }
}

export async function GET(req: NextRequest) {
    return withRequestContextAndRateLimit(req, 'read', () => handleGET(req));
}
