/**
 * Monitoring Alert Acknowledgment API Endpoint
 * 
 * POST /api/v1/monitoring/alerts/:alertId/acknowledge
 * 
 * Acknowledges a monitoring alert.
 * 
 * Requirements: 2.15.4, 2.15.5
 * 
 * Authentication: Required (Admin role only)
 */

import { NextRequest, NextResponse } from 'next/server';
import { prisma } from '@/lib/prisma';
import { logger } from '@/lib/logger';

/**
 * POST handler for alert acknowledgment endpoint
 */
async function handlePOST(
    _req: NextRequest,
    { params }: { params: Promise<{ alertId: string }> }
) {
    // Await params in Next.js 15+
    const { alertId } = await params;

    try {
        // Check authentication
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'UNAUTHORIZED',
                        message: 'Authentication required',
                    }
                },
                { status: 401 }
            );
        }

        // Check admin role
        const isAdmin = session.user.role === 'ADMIN' || session.user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Admin access required',
                    }
                },
                { status: 403 }
            );
        }

        // Validate alertId
        if (!alertId || typeof alertId !== 'string') {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'VALIDATION_ERROR',
                        message: 'Invalid alert ID',
                    }
                },
                { status: 422 }
            );
        }

        // Find the alert
        const alert = await prisma.monitoringAlertHistory.findUnique({
            where: { id: alertId },
        });

        if (!alert) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'NOT_FOUND',
                        message: 'Alert not found',
                    }
                },
                { status: 404 }
            );
        }

        // Check if already acknowledged
        if (alert.acknowledgedAt) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'ALREADY_ACKNOWLEDGED',
                        message: 'Alert has already been acknowledged',
                    }
                },
                { status: 400 }
            );
        }

        // Acknowledge the alert
        const updatedAlert = await prisma.monitoringAlertHistory.update({
            where: { id: alertId },
            data: {
                acknowledgedAt: new Date(),
                acknowledgedBy: session.user.id,
            },
        });

        logger.info('Alert acknowledged', {
            alertId,
            userId: session.user.id,
            userEmail: session.user.email,
            ruleName: alert.ruleName,
            severity: alert.severity,
        });

        return NextResponse.json({
            success: true,
            data: {
                alert: updatedAlert,
            },
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error('Failed to acknowledge alert', {
            error: error instanceof Error ? error.message : String(error),
            alertId,
        });

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: 'INTERNAL_ERROR',
                    message: 'Failed to acknowledge alert',
                    details: error instanceof Error ? error.message : String(error),
                },
            },
            { status: 500 }
        );
    }
}

export async function POST(
    req: NextRequest,
    context: { params: Promise<{ alertId: string }> }
) {
    return withRequestContextAndRateLimit(req, 'write', () => handlePOST(req, context));
}
