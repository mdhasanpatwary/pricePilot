/**
 * Alert Rule Detail API Endpoints
 * 
 * GET /api/v1/monitoring/alert-rules/:id - Get a specific alert rule
 * PUT /api/v1/monitoring/alert-rules/:id - Update an alert rule
 * DELETE /api/v1/monitoring/alert-rules/:id - Delete an alert rule
 * 
 * Requirements: 7.1, 7.2, 7.3, 7.5
 * 
 * Authentication: Required (Admin role only)
 */

import { NextRequest, NextResponse } from 'next/server';
import { alertConfigurationService } from '@/lib/services/monitoring/alert-configuration';
import { logger } from '@/lib/logger';
import { z } from 'zod';

/**
 * Validation schema for alert rule updates
 */
const updateAlertRuleSchema = z.object({
    name: z.string().min(1).max(255).optional(),
    description: z.string().optional(),
    severity: z.enum(['CRITICAL', 'WARNING', 'INFO']).optional(),
    enabled: z.boolean().optional(),
    metricType: z.string().min(1).optional(),
    condition: z.object({
        operator: z.enum(['GT', 'GTE', 'LT', 'LTE', 'EQ']),
        aggregation: z.enum(['COUNT', 'AVG', 'SUM', 'MAX', 'MIN', 'P95', 'P99']),
    }).optional(),
    timeWindow: z.number().positive().max(86400).optional(),
    threshold: z.number().optional(),
    notificationChannels: z.array(z.string()).optional(),
    tenantId: z.string().optional().nullable(),
});

/**
 * GET handler - Get a specific alert rule
 */
async function handleGET(
    _req: NextRequest,
    { params }: { params: Promise<{ id: string }> }
) {
    // Await params
    const { id } = await params;

    try {
        // Check authentication
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'UNAUTHORIZED',
                        message: 'Authentication required',
                    }
                },
                { status: 401 }
            );
        }

        // Check admin role
        const isAdmin = session.user.role === 'ADMIN' || session.user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Admin access required',
                    }
                },
                { status: 403 }
            );
        }

        // Get alert rule
        const rule = await alertConfigurationService.getRule(id);

        logger.info('Alert rule retrieved', {
            userId: session.user.id,
            ruleId: id,
        });

        return NextResponse.json({
            success: true,
            data: rule,
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error('Failed to get alert rule', {
            error: error instanceof Error ? error.message : String(error),
            ruleId: id,
        });

        const status = error instanceof Error && error.message.includes('not found') ? 404 : 500;

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: status === 404 ? 'NOT_FOUND' : 'INTERNAL_ERROR',
                    message: error instanceof Error ? error.message : 'Failed to get alert rule',
                },
            },
            { status }
        );
    }
}

/**
 * PUT handler - Update an alert rule
 */
async function handlePUT(
    req: NextRequest,
    { params }: { params: Promise<{ id: string }> }
) {
    // Await params
    const { id } = await params;

    try {
        // Check authentication
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'UNAUTHORIZED',
                        message: 'Authentication required',
                    }
                },
                { status: 401 }
            );
        }

        // Check admin role
        const isAdmin = session.user.role === 'ADMIN' || session.user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Admin access required',
                    }
                },
                { status: 403 }
            );
        }

        // Parse and validate request body
        const body = await req.json();
        const validationResult = updateAlertRuleSchema.safeParse(body);

        if (!validationResult.success) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'VALIDATION_ERROR',
                        message: 'Invalid request data',
                        details: validationResult.error.issues,
                    },
                },
                { status: 422 }
            );
        }

        // Update alert rule
        const rule = await alertConfigurationService.updateRule(
            id,
            validationResult.data
        );

        logger.info('Alert rule updated', {
            userId: session.user.id,
            ruleId: id,
            updates: Object.keys(validationResult.data),
        });

        return NextResponse.json({
            success: true,
            data: rule,
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error('Failed to update alert rule', {
            error: error instanceof Error ? error.message : String(error),
            ruleId: id,
        });

        const status = error instanceof Error && error.message.includes('not found') ? 404 : 500;

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: status === 404 ? 'NOT_FOUND' : 'INTERNAL_ERROR',
                    message: error instanceof Error ? error.message : 'Failed to update alert rule',
                },
            },
            { status }
        );
    }
}

/**
 * DELETE handler - Delete an alert rule
 */
async function handleDELETE(
    _req: NextRequest,
    { params }: { params: Promise<{ id: string }> }
) {
    // Await params
    const { id } = await params;

    try {
        // Check authentication
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'UNAUTHORIZED',
                        message: 'Authentication required',
                    }
                },
                { status: 401 }
            );
        }

        // Check admin role
        const isAdmin = session.user.role === 'ADMIN' || session.user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: 'FORBIDDEN',
                        message: 'Admin access required',
                    }
                },
                { status: 403 }
            );
        }

        // Delete alert rule
        await alertConfigurationService.deleteRule(id);

        logger.info('Alert rule deleted', {
            userId: session.user.id,
            ruleId: id,
        });

        return NextResponse.json(
            {
                success: true,
                data: {
                    message: 'Alert rule deleted successfully',
                },
                meta: {
                    requestId: crypto.randomUUID(),
                    timestamp: new Date().toISOString(),
                },
            },
            { status: 200 }
        );
    } catch (error) {
        logger.error('Failed to delete alert rule', {
            error: error instanceof Error ? error.message : String(error),
            ruleId: id,
        });

        const status = error instanceof Error && error.message.includes('not found') ? 404 : 500;

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: status === 404 ? 'NOT_FOUND' : 'INTERNAL_ERROR',
                    message: error instanceof Error ? error.message : 'Failed to delete alert rule',
                },
            },
            { status }
        );
    }
}

export async function GET(req: NextRequest, context: { params: Promise<{ id: string }> }) {
    return withRequestContextAndRateLimit(req, 'read', (r) => handleGET(r, context));
}

export async function PUT(req: NextRequest, context: { params: Promise<{ id: string }> }) {
    return withRequestContextAndRateLimit(req, 'write', (r) => handlePUT(r, context));
}

export async function DELETE(req: NextRequest, context: { params: Promise<{ id: string }> }) {
    return withRequestContextAndRateLimit(req, 'write', (r) => handleDELETE(r, context));
}
