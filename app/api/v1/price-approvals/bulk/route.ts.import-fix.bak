import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { BulkApprovalService } from "@/lib/services/bulk-approval";
import { ApprovalDelegationService } from "@/lib/services/approval-delegation";
import { SyncService } from "@/lib/services/sync";
import { prisma } from "@/lib/prisma";

/**
 * POST /api/v1/price-approvals/bulk
 * 
 * Optimized bulk approval endpoint with progress tracking support.
 * This endpoint processes large batches of approvals efficiently using
 * batched database operations and optimized notifications.
 * 
 * Requirements: 2.10.4
 */

const bulkActionSchema = z.object({
    action: z.enum(["approve", "reject"]),
    changeIds: z.array(z.string()).min(1).max(1000), // Limit to 1000 for safety
});

async function handlePOST(req: NextRequest) {
    try {
        const session = await getCachedSession();
        if (!session?.user?.tenantId || !session?.user?.email) {
            return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
        }

        const body = await req.json();
        const { action, changeIds } = bulkActionSchema.parse(body);

        // Check if user has permission to approve
        const canApprove = await ApprovalDelegationService.canApprove(
            session.user.id,
            session.user.tenantId
        );

        if (!canApprove) {
            return NextResponse.json(
                { error: "You do not have permission to approve price changes" },
                { status: 403 }
            );
        }

        // Check if user is acting via delegation
        const activeDelegations = await ApprovalDelegationService.getActiveDelegationsForUser(
            session.user.id,
            session.user.tenantId
        );
        const isDelegated = activeDelegations.length > 0;
        const delegationInfo = isDelegated ? activeDelegations[0] : null;

        // Process bulk operation with optimized service
        let result;
        if (action === "approve") {
            // Use optimized bulk approval service
            result = await BulkApprovalService.applyApprovedChanges(
                changeIds,
                session.user.email
            );

            // Log delegation usage if applicable
            if (isDelegated && delegationInfo) {
                await prisma.tenantAuditLog.create({
                    data: {
                        tenantId: session.user.tenantId,
                        userId: session.user.id,
                        userEmail: session.user.email,
                        action: "BULK_APPROVE_PRICE_VIA_DELEGATION",
                        entityId: `bulk:${changeIds.length}`,
                        details: JSON.stringify({
                            changeCount: changeIds.length,
                            successful: result.successful,
                            failed: result.failed,
                            delegatedFrom: delegationInfo.fromUser.email,
                            delegatedFromName: delegationInfo.fromUser.name,
                            delegationId: delegationInfo.id,
                        }),
                    },
                });
            }

            // Push approved changes to stores (async, don't wait)
            const userSites = await prisma.site.findMany({
                where: { tenantId: session.user.tenantId, type: "USER" },
            });

            // Trigger sync for each site (fire and forget)
            for (const site of userSites) {
                if (site.platform === "OPENCART" || site.platform === "LARAVEL") {
                    SyncService.syncProductsToStore(site.id).catch(error => {
                        console.error(`[BulkApproval] Failed to sync site ${site.id}:`, error);
                    });
                }
            }

            return NextResponse.json({
                success: true,
                message: `${result.successful} price changes approved${isDelegated ? " (via delegation)" : ""}`,
                total: result.total,
                successful: result.successful,
                failed: result.failed,
                errors: result.errors,
                delegated: isDelegated,
            });
        } else {
            // Use optimized bulk rejection service
            result = await BulkApprovalService.rejectPendingChanges(
                changeIds,
                session.user.email
            );

            // Log delegation usage if applicable
            if (isDelegated && delegationInfo) {
                await prisma.tenantAuditLog.create({
                    data: {
                        tenantId: session.user.tenantId,
                        userId: session.user.id,
                        userEmail: session.user.email,
                        action: "BULK_REJECT_PRICE_VIA_DELEGATION",
                        entityId: `bulk:${changeIds.length}`,
                        details: JSON.stringify({
                            changeCount: changeIds.length,
                            successful: result.successful,
                            failed: result.failed,
                            delegatedFrom: delegationInfo.fromUser.email,
                            delegatedFromName: delegationInfo.fromUser.name,
                            delegationId: delegationInfo.id,
                        }),
                    },
                });
            }

            return NextResponse.json({
                success: true,
                message: `${result.successful} price changes rejected${isDelegated ? " (via delegation)" : ""}`,
                total: result.total,
                successful: result.successful,
                failed: result.failed,
                errors: result.errors,
                delegated: isDelegated,
            });
        }
    } catch (error) {
        console.error("[API] Error processing bulk price approvals:", error);

        if (error instanceof z.ZodError) {
            return NextResponse.json(
                {
                    error: "Invalid request data",
                    details: error.issues
                },
                { status: 400 }
            );
        }

        return NextResponse.json(
            { error: "Failed to process bulk price approvals" },
            { status: 500 }
        );
    }
}

export async function POST(req: NextRequest) {
    return withRequestContextAndRateLimit(req, 'write', () => handlePOST(req));
}
