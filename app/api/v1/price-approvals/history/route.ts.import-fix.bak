import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { paginate, getPaginationParams } from "@/lib/utils/pagination";

/**
 * GET /api/v1/price-approvals/history
 * Get approval history for the tenant with search and filter capabilities
 * 
 * Query Parameters:
 * - page: Page number (default: 1)
 * - limit: Items per page (default: 20, max: 100)
 * - sortBy: Sort field (default: createdAt)
 * - sortOrder: Sort order (asc/desc, default: desc)
 * - action: Filter by action (APPROVE_PRICE, REJECT_PRICE, AUTO_APPROVE_PRICE, etc.)
 * - userId: Filter by user ID
 * - startDate: Filter by start date (ISO string)
 * - endDate: Filter by end date (ISO string)
 * - search: Search in product title, SKU, or user email
 * 
 * Requirements: 2.10.5
 */
async function handleGET(req: NextRequest) {
    try {
        const session = await getCachedSession();
        if (!session?.user?.tenantId) {
            return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
        }

        const { searchParams } = new URL(req.url);

        // Get pagination parameters
        const paginationParams = getPaginationParams(searchParams);

        // Get filter parameters
        const action = searchParams.get("action");
        const userId = searchParams.get("userId");
        const startDate = searchParams.get("startDate");
        const endDate = searchParams.get("endDate");
        const search = searchParams.get("search");

        // Build where clause
        const where: any = {
            tenantId: session.user.tenantId,
            action: {
                in: [
                    "APPROVE_PRICE",
                    "REJECT_PRICE",
                    "AUTO_APPROVE_PRICE",
                    "APPROVE_PRICE_VIA_DELEGATION",
                    "REJECT_PRICE_VIA_DELEGATION",
                    "BULK_PRICE_APPROVAL",
                ],
            },
        };

        // Apply action filter
        if (action) {
            where.action = action;
        }

        // Apply user filter
        if (userId) {
            where.userId = userId;
        }

        // Apply date range filter
        if (startDate || endDate) {
            where.createdAt = {};
            if (startDate) {
                where.createdAt.gte = new Date(startDate);
            }
            if (endDate) {
                where.createdAt.lte = new Date(endDate);
            }
        }

        // Apply search filter
        if (search) {
            where.OR = [
                { userEmail: { contains: search, mode: "insensitive" } },
                { details: { contains: search, mode: "insensitive" } },
            ];
        }

        // Use pagination helper
        const paginatedResult = await paginate(
            prisma.tenantAuditLog,
            where,
            {
                ...paginationParams,
                sortBy: paginationParams.sortBy || 'createdAt',
                sortOrder: paginationParams.sortOrder || 'desc'
            }
        );

        // Parse details JSON for each log entry
        const historyWithParsedDetails = paginatedResult.data.map((log: any) => {
            let parsedDetails = null;
            try {
                parsedDetails = log.details ? JSON.parse(log.details) : null;
            } catch (error) {
                console.error(`Failed to parse details for log ${log.id}:`, error);
            }

            return {
                id: log.id,
                userId: log.userId,
                userEmail: log.userEmail,
                action: log.action,
                entityId: log.entityId,
                details: parsedDetails,
                ipAddress: log.ipAddress,
                createdAt: log.createdAt,
            };
        });

        return NextResponse.json({
            history: historyWithParsedDetails,
            pagination: paginatedResult.pagination,
        });
    } catch (error) {
        console.error("[API] Error fetching approval history:", error);
        return NextResponse.json(
            { error: "Failed to fetch approval history" },
            { status: 500 }
        );
    }
}

export async function GET(req: NextRequest) {
    return withRequestContextAndRateLimit(req, 'read', () => handleGET(req));
}
