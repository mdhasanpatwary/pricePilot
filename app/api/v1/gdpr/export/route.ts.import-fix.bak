/**
 * GDPR Data Export API
 * 
 * Implements GDPR Article 15 (Right to Access) and Article 20 (Right to Data Portability)
 */

import { NextRequest, NextResponse } from 'next/server';
import { GDPRService } from '@/lib/services/gdpr-service';
import { logger } from '@/lib/logger';

export async function POST(req: NextRequest) {
    try {
        const session = await getCachedSession();

        if (!session?.user?.id) {
            return NextResponse.json(
                { success: false, error: 'Unauthorized' },
                { status: 401 }
            );
        }

        const { deliveryMethod } = await req.json();

        if (deliveryMethod === 'email') {
            // Send data export via email
            if (!session.user.email) {
                return NextResponse.json(
                    {
                        success: false,
                        error: {
                            code: 'INVALID_REQUEST',
                            message: 'User email not found',
                        }
                    },
                    { status: 400 }
                );
            }

            await GDPRService.requestDataExport(session.user.id, session.user.email);

            return NextResponse.json({
                success: true,
                message: 'Data export will be sent to your email within 24 hours',
            });
        } else {
            // Return data directly
            const exportData = await GDPRService.exportUserData(session.user.id);

            return NextResponse.json({
                success: true,
                data: exportData,
            });
        }
    } catch (error) {
        logger.error('GDPR data export failed', { error });
        return NextResponse.json(
            {
                success: false,
                error: 'Failed to export data',
            },
            { status: 500 }
        );
    }
}

export async function GET(_req: NextRequest) {
    try {
        const session = await getCachedSession();

        if (!session?.user?.id) {
            return NextResponse.json(
                { success: false, error: 'Unauthorized' },
                { status: 401 }
            );
        }

        // Return data directly for download
        const exportData = await GDPRService.exportUserData(session.user.id);

        // Return as downloadable JSON file
        return new NextResponse(JSON.stringify(exportData, null, 2), {
            status: 200,
            headers: {
                'Content-Type': 'application/json',
                'Content-Disposition': `attachment; filename="pricepilot-data-export-${new Date().toISOString().split('T')[0]}.json"`,
            },
        });
    } catch (error) {
        logger.error('GDPR data export download failed', { error });
        return NextResponse.json(
            {
                success: false,
                error: 'Failed to export data',
            },
            { status: 500 }
        );
    }
}
