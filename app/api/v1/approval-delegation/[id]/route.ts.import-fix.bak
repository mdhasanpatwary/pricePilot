/**
 * API endpoints for managing specific delegations
 * 
 * PATCH  /api/v1/approval-delegation/[id] - Update delegation dates
 * DELETE /api/v1/approval-delegation/[id] - Revoke delegation
 */

import { NextRequest, NextResponse } from 'next/server';
import { ApprovalDelegationService } from '@/lib/services/approval-delegation';
import { z } from 'zod';

const updateDelegationSchema = z.object({
    startDate: z.string().datetime(),
    endDate: z.string().datetime(),
});

/**
 * PATCH /api/v1/approval-delegation/[id]
 * Update delegation dates
 */
export async function PATCH(
    req: NextRequest,
    { params }: { params: Promise<{ id: string }> }
) {
    try {
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                { success: false, error: 'Unauthorized' },
                { status: 401 }
            );
        }

        const { id } = await params;
        const body = await req.json();
        const validated = updateDelegationSchema.parse(body);

        const delegation = await ApprovalDelegationService.updateDelegation(
            id,
            session.user.tenantId,
            new Date(validated.startDate),
            new Date(validated.endDate)
        );

        return NextResponse.json({
            success: true,
            data: delegation
        });
    } catch (error) {
        console.error('Error updating delegation:', error);

        if (error instanceof z.ZodError) {
            return NextResponse.json(
                {
                    success: false,
                    error: 'Validation error',
                    details: error.issues
                },
                { status: 422 }
            );
        }

        return NextResponse.json(
            {
                success: false,
                error: error instanceof Error ? error.message : 'Failed to update delegation'
            },
            { status: 500 }
        );
    }
}

/**
 * DELETE /api/v1/approval-delegation/[id]
 * Revoke a delegation
 */
export async function DELETE(
    _req: NextRequest,
    { params }: { params: Promise<{ id: string }> }
) {
    try {
        const session = await getCachedSession();

        if (!session?.user) {
            return NextResponse.json(
                { success: false, error: 'Unauthorized' },
                { status: 401 }
            );
        }

        const { id } = await params;

        await ApprovalDelegationService.revokeDelegation(
            id,
            session.user.tenantId
        );

        return NextResponse.json({
            success: true,
            message: 'Delegation revoked successfully'
        });
    } catch (error) {
        console.error('Error revoking delegation:', error);

        return NextResponse.json(
            {
                success: false,
                error: error instanceof Error ? error.message : 'Failed to revoke delegation'
            },
            { status: 500 }
        );
    }
}
