import { NextRequest, NextResponse } from "next/server";
import { ExportService, ExportFormat } from "@/lib/services/export-service";
import { prisma } from "@/lib/prisma";
import { Prisma } from "@prisma/client";

/**
 * GET /api/v1/admin/export/errors
 * Export error logs in specified format
 * 
 * Query Parameters:
 * - format: json | csv | pdf (default: json)
 * - tenantId: Filter by tenant (optional)
 * - startDate: Filter by start date (optional)
 * - endDate: Filter by end date (optional)
 * 
 * Requirements: 15.3, 15.5
 */
async function handleGET(request: NextRequest) {
    try {
        const session = await getCachedSession();
        if (!session?.user) {
            return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
        }

        const user = session.user as any;
        const isAdmin = user.role === "ADMIN" || user.isSuperAdmin === true;

        if (!isAdmin) {
            return NextResponse.json({ error: "Unauthorized - Admin access required" }, { status: 401 });
        }

        // Parse query parameters
        const searchParams = request.nextUrl.searchParams;
        const format = (searchParams.get("format") || "json") as ExportFormat;
        const tenantId = searchParams.get("tenantId") || undefined;
        const startDate = searchParams.get("startDate")
            ? new Date(searchParams.get("startDate")!)
            : new Date(Date.now() - 7 * 24 * 60 * 60 * 1000); // Default: last 7 days
        const endDate = searchParams.get("endDate")
            ? new Date(searchParams.get("endDate")!)
            : new Date();

        // Validate format
        if (!["json", "csv", "pdf"].includes(format)) {
            return NextResponse.json(
                { error: "Invalid format. Must be json, csv, or pdf" },
                { status: 400 }
            );
        }

        // Fetch error logs from scraping sessions
        const sessions = await prisma.scrapingSession.findMany({
            where: {
                startTime: {
                    gte: startDate,
                    lte: endDate,
                },
                ...(tenantId && { tenantId }),
                errors: {
                    not: Prisma.JsonNull,
                },
            },
            select: {
                id: true,
                tenantId: true,
                tenantName: true,
                siteUrl: true,
                targetUrl: true,
                proxyUsed: true,
                errors: true,
                startTime: true,
            },
            orderBy: {
                startTime: "desc",
            },
            take: 1000, // Limit to prevent memory issues
        });

        // Extract and format errors
        const errorLogs: any[] = [];

        sessions.forEach(session => {
            if (!session.errors) return;

            let errors: any[] = [];
            if (typeof session.errors === "string") {
                try {
                    errors = JSON.parse(session.errors);
                } catch {
                    errors = [{ message: session.errors }];
                }
            } else if (Array.isArray(session.errors)) {
                errors = session.errors;
            } else if (typeof session.errors === "object") {
                errors = [session.errors];
            }

            errors.forEach((error: any) => {
                errorLogs.push({
                    timestamp: error.timestamp || session.startTime.toISOString(),
                    sessionId: session.id,
                    tenantId: session.tenantId,
                    tenantName: session.tenantName,
                    siteUrl: session.siteUrl,
                    targetUrl: session.targetUrl,
                    proxyUsed: session.proxyUsed || "N/A",
                    type: categorizeError(error.message || error.error || "Unknown"),
                    message: error.message || error.error || "Unknown error",
                    stack: error.stack || undefined,
                });
            });
        });

        // Export errors
        const exported = await ExportService.exportErrors(errorLogs, { format });

        // Return file
        return new NextResponse(exported.data as any, {
            headers: {
                "Content-Type": exported.contentType,
                "Content-Disposition": `attachment; filename="${exported.filename}"`,
            },
        });
    } catch (error) {
        console.error("[Export Errors API] Error:", error);
        return NextResponse.json(
            {
                success: false,
                error: "Failed to export errors",
                details: error instanceof Error ? error.message : "Unknown error"
            },
            { status: 500 }
        );
    }
}

function categorizeError(message: string): string {
    const lowerMessage = message.toLowerCase();

    if (lowerMessage.includes("proxy") || lowerMessage.includes("connection")) {
        return "proxy_failure";
    }
    if (lowerMessage.includes("captcha") || lowerMessage.includes("challenge") || lowerMessage.includes("cloudflare")) {
        return "challenge_failure";
    }
    if (lowerMessage.includes("parse") || lowerMessage.includes("extract")) {
        return "parsing_error";
    }
    if (lowerMessage.includes("rate limit") || lowerMessage.includes("too many requests")) {
        return "rate_limit";
    }
    if (lowerMessage.includes("timeout") || lowerMessage.includes("timed out")) {
        return "timeout";
    }
    if (lowerMessage.includes("network") || lowerMessage.includes("econnrefused")) {
        return "network_error";
    }

    return "unknown";
}

export async function GET(req: NextRequest) {
    return withRequestContextAndRateLimit(req, "importExport", handleGET);
}
