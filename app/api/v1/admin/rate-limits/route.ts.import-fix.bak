import { NextRequest, NextResponse } from "next/server";
import { getAllTenantsStatus } from "@/lib/services/rate-limit-admin";
import { logger } from "@/lib/logger";

/**
 * GET /api/v1/admin/rate-limits
 * 
 * Returns rate limit status for all tenants in the system.
 * This endpoint provides an overview of rate limiting across all tenants,
 * including current limits, violations, bypasses, and custom multipliers.
 * 
 * Requirements: 4.1
 * 
 * Authentication: Super admin only
 * Rate Limiting: Read limiter
 * 
 * Response:
 * {
 *   "success": true,
 *   "data": {
 *     "tenants": [
 *       {
 *         "tenantId": "string",
 *         "companyName": "string",
 *         "planType": "BASIC" | "PREMIUM" | "PRO",
 *         "effectiveMultiplier": number,
 *         "bypassActive": boolean,
 *         "bypassExpiresAt": "ISO8601" (optional),
 *         "bypassReason": "string" (optional),
 *         "customMultiplier": number (optional),
 *         "customMultiplierReason": "string" (optional),
 *         "recentViolations": number,
 *         "currentUsage": {
 *           "auth": { "limit": number, "window": "string" },
 *           "api": { "limit": number, "window": "string" },
 *           ...
 *         }
 *       }
 *     ],
 *     "summary": {
 *       "totalTenants": number,
 *       "tenantsWithViolations": number,
 *       "tenantsWithBypasses": number,
 *       "tenantsWithCustomMultipliers": number
 *     }
 *   },
 *   "meta": {
 *     "requestId": "string",
 *     "timestamp": "ISO8601"
 *   }
 * }
 */
async function handleGET(_req: NextRequest) {
    try {
        // Check authentication and authorization
        const session = await getCachedSession();

        if (!session || !session.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "UNAUTHORIZED",
                        message: "Authentication required",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 401 }
            );
        }

        if (!session.user.isSuperAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "FORBIDDEN",
                        message: "Super admin access required",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 403 }
            );
        }

        // Get rate limit status for all tenants
        const tenants = await getAllTenantsStatus();

        // Calculate summary statistics
        const summary = {
            totalTenants: tenants.length,
            tenantsWithViolations: tenants.filter((t) => t.recentViolations > 0).length,
            tenantsWithBypasses: tenants.filter((t) => t.bypassActive).length,
            tenantsWithCustomMultipliers: tenants.filter((t) => t.customMultiplier !== undefined).length,
        };

        logger.info("[RateLimitAPI] Retrieved all tenants status", {
            adminUserId: session.user.id,
            totalTenants: summary.totalTenants,
        });

        return NextResponse.json({
            success: true,
            data: {
                tenants,
                summary,
            },
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error("[RateLimitAPI] Failed to get all tenants status:", { error });

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: "INTERNAL_ERROR",
                    message: "Failed to retrieve rate limit status",
                    details: error instanceof Error ? error.message : "Unknown error",
                },
                meta: {
                    requestId: crypto.randomUUID(),
                    timestamp: new Date().toISOString(),
                },
            },
            { status: 500 }
        );
    }
}

export async function GET(req: NextRequest) {
    return withRequestContextAndRateLimit(req, "read", handleGET);
}
