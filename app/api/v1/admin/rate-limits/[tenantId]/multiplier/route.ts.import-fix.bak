import { NextRequest, NextResponse } from "next/server";
import { setCustomMultiplier } from "@/lib/services/rate-limit-admin";
import { logger } from "@/lib/logger";

/**
 * POST /api/v1/admin/rate-limits/[tenantId]/multiplier
 * 
 * Sets a custom rate limit multiplier for a specific tenant.
 * This overrides the plan-based multiplier with a custom value.
 * Useful for special pricing arrangements or temporary adjustments.
 * 
 * Requirements: 4.4, 4.5
 * 
 * Authentication: Super admin only
 * Rate Limiting: Write limiter
 * 
 * Request Body:
 * {
 *   "multiplier": number (0.1-100),
 *   "reason": string (min 10 characters)
 * }
 * 
 * Response:
 * {
 *   "success": true,
 *   "data": {
 *     "tenantId": "string",
 *     "multiplier": number,
 *     "reason": "string"
 *   },
 *   "meta": {
 *     "requestId": "string",
 *     "timestamp": "ISO8601"
 *   }
 * }
 */
async function handlePOST(
    req: NextRequest,
    { params }: { params: { tenantId: string } }
) {
    try {
        // Check authentication and authorization
        const session = await getCachedSession();

        if (!session || !session.user) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "UNAUTHORIZED",
                        message: "Authentication required",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 401 }
            );
        }

        if (!session.user.isSuperAdmin) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "FORBIDDEN",
                        message: "Super admin access required",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 403 }
            );
        }

        const { tenantId } = params;

        // Validate tenantId
        if (!tenantId || typeof tenantId !== "string") {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "INVALID_TENANT_ID",
                        message: "Valid tenant ID is required",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 400 }
            );
        }

        // Parse request body
        let body;
        try {
            body = await req.json();
        } catch {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "INVALID_JSON",
                        message: "Invalid JSON in request body",
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 400 }
            );
        }

        const { multiplier, reason } = body;

        // Validate input
        const errors: Record<string, string[]> = {};

        if (typeof multiplier !== "number") {
            errors.multiplier = ["Multiplier must be a number"];
        } else if (multiplier < 0.1 || multiplier > 100) {
            errors.multiplier = ["Multiplier must be between 0.1 and 100"];
        } else if (isNaN(multiplier) || !isFinite(multiplier)) {
            errors.multiplier = ["Multiplier must be a valid number"];
        }

        if (typeof reason !== "string") {
            errors.reason = ["Reason must be a string"];
        } else if (reason.trim().length < 10) {
            errors.reason = ["Reason must be at least 10 characters"];
        }

        if (Object.keys(errors).length > 0) {
            return NextResponse.json(
                {
                    success: false,
                    error: {
                        code: "VALIDATION_ERROR",
                        message: "Validation failed",
                        details: { fields: errors },
                    },
                    meta: {
                        requestId: crypto.randomUUID(),
                        timestamp: new Date().toISOString(),
                    },
                },
                { status: 422 }
            );
        }

        // Get client IP for audit log
        const ipAddress = req.headers.get("x-forwarded-for") ||
            req.headers.get("x-real-ip") ||
            "unknown";

        // Set custom multiplier
        await setCustomMultiplier(
            tenantId,
            session.user.id,
            multiplier,
            reason.trim(),
            ipAddress
        );

        logger.info("[RateLimitAPI] Custom multiplier set successfully", {
            adminUserId: session.user.id,
            tenantId,
            multiplier,
        });

        return NextResponse.json({
            success: true,
            data: {
                tenantId,
                multiplier,
                reason: reason.trim(),
            },
            meta: {
                requestId: crypto.randomUUID(),
                timestamp: new Date().toISOString(),
            },
        });
    } catch (error) {
        logger.error("[RateLimitAPI] Failed to set custom multiplier:", { error });

        // Check for specific error messages
        if (error instanceof Error) {
            if (error.message.includes("not found")) {
                return NextResponse.json(
                    {
                        success: false,
                        error: {
                            code: "TENANT_NOT_FOUND",
                            message: error.message,
                        },
                        meta: {
                            requestId: crypto.randomUUID(),
                            timestamp: new Date().toISOString(),
                        },
                    },
                    { status: 404 }
                );
            }

            if (error.message.includes("Multiplier") || error.message.includes("Reason")) {
                return NextResponse.json(
                    {
                        success: false,
                        error: {
                            code: "VALIDATION_ERROR",
                            message: error.message,
                        },
                        meta: {
                            requestId: crypto.randomUUID(),
                            timestamp: new Date().toISOString(),
                        },
                    },
                    { status: 422 }
                );
            }
        }

        return NextResponse.json(
            {
                success: false,
                error: {
                    code: "INTERNAL_ERROR",
                    message: "Failed to set custom multiplier",
                    details: error instanceof Error ? error.message : "Unknown error",
                },
                meta: {
                    requestId: crypto.randomUUID(),
                    timestamp: new Date().toISOString(),
                },
            },
            { status: 500 }
        );
    }
}

export async function POST(req: NextRequest, context: { params: Promise<{ tenantId: string }> }) {
    const params = await context.params;
    return withRequestContextAndRateLimit(req, "write", (r) => handlePOST(r, { params }));
}
