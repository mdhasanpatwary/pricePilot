generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String        @id @default(uuid())
  companyName     String
  planType        PlanType      @default(BASIC)
  currency        String        @default("USD")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  competitorLimit Int           @default(3)
  storeLimit      Int           @default(1)
  pricingRules    PricingRule[]
  products        Product[]
  sites           Site[]
  users           User[]
  webhooks        Webhook[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isSuperAdmin Boolean  @default(false)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Site {
  id         String       @id @default(uuid())
  tenantId   String
  type       SiteType
  platform   PlatformType @default(GENERIC)
  baseUrl    String
  currency   String       @default("USD")
  apiToken   String?
  lastSyncAt     DateTime?
  isSyncing      Boolean      @default(false)
  syncTotal      Int          @default(0)
  syncProcessed  Int          @default(0)
  syncLastAction String?
  syncStartedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  products   Product[]
  syncLogs   SyncLog[]
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
}

model SyncLog {
  id        String   @id @default(uuid())
  siteId    String
  message   String
  level     String   @default("INFO")
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Product {
  id                  String           @id @default(uuid())
  siteId              String
  tenantId            String
  externalId          String?
  sku                 String?
  url                 String?
  title               String
  category            String?
  brand               String?
  model               String?
  currentPrice        Decimal          @db.Decimal(10, 2)
  currency            String           @default("USD")
  lastCrawledAt       DateTime?
  inStock             Boolean          @default(true)
  stockLevel          Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  priceHistory        PriceHistory[]
  updateLogs          PriceUpdateLog[]
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  matchesAsCompetitor ProductMatch[]   @relation("CompetitorProduct")
  matchesAsUser       ProductMatch[]   @relation("UserProduct")

  @@index([sku])
  @@index([tenantId])
}

model ProductMatch {
  id                  String    @id @default(uuid())
  userProductId       String
  competitorProductId String
  matchType           MatchType @default(AUTO_SKU)
  confidenceScore     Decimal   @db.Decimal(5, 2)
  createdAt           DateTime  @default(now())
  competitorProduct   Product   @relation("CompetitorProduct", fields: [competitorProductId], references: [id], onDelete: Cascade)
  userProduct         Product   @relation("UserProduct", fields: [userProductId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceUpdateLog {
  id           String       @id @default(uuid())
  productId    String
  oldPrice     Decimal      @db.Decimal(10, 2)
  newPrice     Decimal      @db.Decimal(10, 2)
  logicType    LogicType
  status       UpdateStatus @default(SUCCESS)
  errorDetails String?
  executedAt   DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  strategy    StrategyType
  parameter   Decimal      @db.Decimal(10, 2)
  priority    Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  type        String   @default("string") // string, number, boolean, json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


enum PlanType {
  BASIC
  PREMIUM
  PRO
}

enum Role {
  ADMIN
  VIEWER
}

enum SiteType {
  USER
  COMPETITOR
}

enum PlatformType {
  OPENCART
  LARAVEL
  GENERIC
  SHOPIFY
  WOOCOMMERCE
  MAGENTO
  PRESTASHOP
  BIGCOMMERCE
}

enum MatchType {
  AUTO_SKU
  AUTO_MODEL
  MANUAL
}

enum LogicType {
  FIXED
  PERCENTAGE
}

enum UpdateStatus {
  SUCCESS
  FAILED
}

enum StrategyType {
  UNDERCUT
  MATCH
  MARGIN_LOCK
  THRESHOLD
  PERCENTAGE
  INVENTORY_HIKE
}
