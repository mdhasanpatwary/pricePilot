generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Alert {
  id             String    @id @default(cuid())
  severity       String
  type           String
  message        String
  site           String?
  proxyUrl       String?
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([acknowledged, createdAt])
  @@index([severity])
}

model AlertRule {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  type        AlertRuleType  @default(PRICE_CHANGE)
  target      AlertTarget    @default(ALL_PRODUCTS)
  targetId    String?
  condition   AlertCondition @default(LESS_THAN)
  value       Decimal        @db.Decimal(10, 2)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime @updatedAt
  Tenant      Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  prefix     String
  userId     String
  tenantId   String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  Tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model ApiPattern {
  id                  String    @id @default(cuid())
  tenantId            String
  competitorWebsiteId String    @unique
  pattern             Json
  confidenceScore     Int
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  Site                Site      @relation(fields: [competitorWebsiteId], references: [id], onDelete: Cascade)
  Tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([competitorWebsiteId])
  @@index([tenantId])
}

model ApprovalDelegation {
  id                                       String   @id @default(cuid())
  tenantId                                 String
  fromUserId                               String
  toUserId                                 String
  startDate                                DateTime
  endDate                                  DateTime
  isActive                                 Boolean  @default(true)
  createdAt                                DateTime @default(now())
  fromUser  User   @relation("ApprovalDelegation_fromUserIdToUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  Tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toUser    User   @relation("ApprovalDelegation_toUserIdToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, fromUserId])
  @@index([tenantId, toUserId, isActive])
}

model ArchivedBulkOperationSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  operation      String
  productCount   Int
  snapshot       String
  changes        String
  rolledBack     Boolean
  idempotencyKey String?
  createdAt      DateTime
  archivedAt     DateTime @default(now())

  @@index([archivedAt])
  @@index([createdAt])
  @@index([tenantId])
}

model ArchivedNotification {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  title      String
  message    String
  link       String?
  isRead     Boolean
  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([archivedAt])
  @@index([createdAt])
  @@index([tenantId])
}

model ArchivedPriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime
  archivedAt DateTime @default(now())

  @@index([archivedAt])
  @@index([productId])
  @@index([recordedAt])
}

model ArchivedPriceUpdateLog {
  id           String   @id @default(cuid())
  productId    String
  oldPrice     Decimal  @db.Decimal(10, 2)
  newPrice     Decimal  @db.Decimal(10, 2)
  logicType    String
  status       String
  errorDetails String?
  executedAt   DateTime
  archivedAt   DateTime @default(now())

  @@index([archivedAt])
  @@index([executedAt])
  @@index([productId])
}

model ArchivedSyncLog {
  id         String   @id @default(cuid())
  siteId     String
  message    String
  level      String
  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([archivedAt])
  @@index([createdAt])
  @@index([siteId])
}

model ArchivedTenantAuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  userEmail  String
  action     String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([archivedAt])
  @@index([createdAt])
  @@index([tenantId])
  @@index([userId])
}

model AutoApprovalMetric {
  id               String   @id @default(cuid())
  tenantId         String
  ruleId           String?
  ruleName         String?
  triggerCount     Int      @default(0)
  nonMatchingCount Int      @default(0)
  totalEvaluated   Int      @default(0)
  date             DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ruleId, date])
  @@index([ruleId, date])
  @@index([tenantId, date])
}

model AutoApprovalRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  enabled     Boolean  @default(true)
  priority    Int      @default(1)
  conditions  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled, priority])
  @@index([tenantId])
}

model Brand {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  aliases   String[]
  logoUrl   String?
  website   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Product   Product[]

  @@unique([tenantId, slug])
}

model BulkOperationSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  operation      String
  productCount   Int
  snapshot       String
  changes        String
  rolledBack     Boolean  @default(false)
  idempotencyKey String?
  createdAt      DateTime @default(now())
  Tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([idempotencyKey])
  @@index([tenantId])
}

model CaptchaSolveAttempt {
  id           String   @id @default(cuid())
  site         String
  captchaType  String
  success      Boolean
  solveTime    Int
  cost         Float
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([captchaType, timestamp])
  @@index([site, timestamp])
}

model Category {
  id             String     @id @default(cuid())
  tenantId       String
  name           String
  slug           String
  description    String?
  parentId       String?
  level          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime @updatedAt
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Product        Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model ChallengeAttempt {
  id            String   @id @default(cuid())
  site          String
  challengeType String
  solved        Boolean
  duration      Int
  timestamp     DateTime @default(now())

  @@index([challengeType, timestamp])
  @@index([site, timestamp])
}

model ConcurrencyState {
  id                 String   @id @default(cuid())
  site               String   @unique
  currentConcurrency Int      @default(3)
  activeRequests     Int      @default(0)
  lastAdjustedAt     DateTime @default(now())
  adjustmentReason   String?

  @@index([site])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model DocumentationDocument {
  id                      String                    @id @default(cuid())
  type                    DocumentationType
  slug                    String
  title                   String                    @db.VarChar(500)
  content                 String
  htmlContent             String
  category                String                    @db.VarChar(100)
  subcategory             String?                   @db.VarChar(100)
  metadata                Json                      @default("{}")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime @updatedAt
  updatedBy               String?
  DocumentationFeedback   DocumentationFeedback[]
  DocumentationPageView   DocumentationPageView[]
  DocumentationSuggestion DocumentationSuggestion[]
  DocumentationVersion    DocumentationVersion[]

  @@unique([type, slug])
  @@index([slug])
  @@index([type, category])
  @@index([updatedAt(sort: Desc)])
  @@index([type, category, updatedAt(sort: Desc)], map: "idx_docs_type_category_updated")
}

model DocumentationFeedback {
  id                    String                @id @default(cuid())
  documentId            String
  rating                Int
  comment               String?
  userId                String?
  createdAt             DateTime              @default(now())
  DocumentationDocument DocumentationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([rating])
  @@index([documentId, rating, createdAt(sort: Desc)], map: "idx_feedback_doc_rating")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model DocumentationLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level      String   @db.VarChar(10)
  category   String   @db.VarChar(50)
  message    String
  metadata   Json?    @default("{}")
  userId     String?  @db.VarChar(255)
  documentId String?  @db.Uuid
  errorStack String?
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  @@index([category, createdAt(sort: Desc)], map: "idx_doclog_category_created")
  @@index([createdAt(sort: Desc)], map: "idx_doclog_created")
  @@index([documentId, createdAt(sort: Desc)], map: "idx_doclog_document")
  @@index([level, createdAt(sort: Desc)], map: "idx_doclog_level_created")
  @@index([userId, createdAt(sort: Desc)], map: "idx_doclog_user")
}

model DocumentationPageView {
  id                    String                @id @default(cuid())
  documentId            String
  type                  DocumentationType
  userId                String?
  sessionId             String?               @db.VarChar(255)
  viewedAt              DateTime              @default(now())
  timeOnPage            Int?
  DocumentationDocument DocumentationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, viewedAt(sort: Desc)])
  @@index([type, viewedAt(sort: Desc)])
  @@index([documentId, viewedAt(sort: Desc)], map: "idx_pageviews_doc_count")
}

model DocumentationRedirect {
  id        String   @id @default(cuid())
  oldPath   String   @unique @db.VarChar(500)
  newPath   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([oldPath])
}

model DocumentationSearch {
  id              String            @id @default(cuid())
  query           String
  type            DocumentationType
  resultsCount    Int
  clickedResultId String?
  searchedAt      DateTime          @default(now())

  @@index([query])
  @@index([type, searchedAt(sort: Desc)])
  @@index([type, searchedAt(sort: Desc), resultsCount], map: "idx_search_type_date_results")
}

model DocumentationSuggestion {
  id                    String                        @id @default(cuid())
  documentId            String?
  suggestedTitle        String?                       @db.VarChar(500)
  suggestedContent      String
  targetType            DocumentationType
  category              String                        @db.VarChar(100)
  status                DocumentationSuggestionStatus @default(PENDING)
  taskId                String?                       @db.VarChar(255)
  createdAt             DateTime                      @default(now())
  reviewedBy            String?
  reviewedAt            DateTime?
  DocumentationDocument DocumentationDocument?        @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([status, createdAt(sort: Desc)])
}

model DocumentationVersion {
  id                    String                @id @default(cuid())
  documentId            String
  content               String
  changeDescription     String?
  createdBy             String
  createdAt             DateTime              @default(now())
  DocumentationDocument DocumentationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt(sort: Desc)])
  @@index([documentId, createdAt(sort: Desc)], map: "idx_versions_doc_created")
}

model DowntimeIncident {
  id        String    @id @default(cuid())
  startTime DateTime
  endTime   DateTime?
  duration  Int?
  reason    String?
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved])
  @@index([startTime(sort: Desc)])
}

model FeedbackPrompt {
  id              String   @id @default(cuid())
  tenantId        String?
  trigger         String
  feature         String?
  enabled         Boolean  @default(true)
  promptText      String
  promptFrequency Int      @default(7)
  minActionsCount Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([tenantId])
  @@index([trigger])
}

model HumanSimulationConfig {
  id                   String   @id @default(cuid())
  typingMinDelay       Int      @default(50)
  typingMaxDelay       Int      @default(150)
  actionPauseMin       Int      @default(100)
  actionPauseMax       Int      @default(2000)
  mouseMovementEnabled Boolean  @default(true)
  naturalCurvesEnabled Boolean  @default(true)
  pauseBetweenFields   Int      @default(500)
  simulateCorrections  Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model IndexRecommendation {
  id              String    @id @default(cuid())
  tableName       String
  columns         String[]
  reason          String
  estimatedImpact String
  createStatement String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  appliedAt       DateTime?

  @@index([status])
  @@index([tableName])
}

model MonitoringAlertHistory {
  id                  String                  @id @default(cuid())
  ruleId              String
  ruleName            String
  severity            MonitoringAlertSeverity
  triggeredAt         DateTime                @default(now())
  resolvedAt          DateTime?
  metricValue         Decimal                 @db.Decimal(10, 2)
  threshold           Decimal                 @db.Decimal(10, 2)
  tenantId            String?
  context             Json?
  notificationsSent   Json?
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  MonitoringAlertRule MonitoringAlertRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([severity])
  @@index([tenantId])
  @@index([triggeredAt])
}

model MonitoringAlertRule {
  id                     String                    @id @default(cuid())
  tenantId               String?
  name                   String
  description            String?
  severity               MonitoringAlertSeverity   @default(WARNING)
  enabled                Boolean                   @default(true)
  metricType             String
  conditionOperator      MonitoringConditionOp     @default(GT)
  conditionAggregation   MonitoringAggregationType @default(AVG)
  timeWindowSeconds      Int
  threshold              Decimal                   @db.Decimal(10, 2)
  notificationChannels   String[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime @updatedAt
  MonitoringAlertHistory MonitoringAlertHistory[]
  Tenant                 Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([metricType])
  @@index([tenantId])
}

model MonitoringMaintenanceWindow {
  id          String   @id @default(cuid())
  name        String
  description String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([startTime, endTime])
}

model MonitoringNotificationChannel {
  id        String                @id @default(cuid())
  type      MonitoringChannelType
  name      String
  enabled   Boolean               @default(true)
  config    Json
  createdAt DateTime              @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([type])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([isRead])
  @@index([tenantId])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingPriceChange {
  id               String         @id @default(cuid())
  productId        String
  tenantId         String
  currentPrice     Decimal        @db.Decimal(10, 2)
  recommendedPrice Decimal        @db.Decimal(10, 2)
  reason           String
  appliedRule      String?
  status           ApprovalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  expiresAt        DateTime
  autoApprovedAt   DateTime?
  autoApprovedBy   String?
  Product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  Tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([productId])
  @@index([tenantId, status])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  Product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, recordedAt])
  @@index([productId, recordedAt(sort: Desc)])
  @@index([recordedAt])
}

model PriceUpdateLog {
  id           String       @id @default(cuid())
  productId    String
  oldPrice     Decimal      @db.Decimal(10, 2)
  newPrice     Decimal      @db.Decimal(10, 2)
  logicType    LogicType
  status       UpdateStatus @default(SUCCESS)
  errorDetails String?
  executedAt   DateTime     @default(now())
  Product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, executedAt(sort: Desc)])
  @@index([executedAt])
}

model PriceUpdateRetryQueue {
  id          String   @id @default(cuid())
  productId   String
  tenantId    String
  retryCount  Int      @default(0)
  lastError   String?
  nextRetryAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId, nextRetryAt])
}

model PricingRule {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  strategy    StrategyType
  parameter   Decimal      @db.Decimal(10, 2)
  priority    Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime @updatedAt
  Tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Product {
  id                                                     String                  @id @default(cuid())
  siteId                                                 String
  tenantId                                               String
  externalId                                             String?
  sku                                                    String?
  url                                                    String?
  title                                                  String
  brand                                                  String?
  model                                                  String?
  currentPrice                                           Decimal                 @db.Decimal(10, 2)
  currency                                               String                  @default("USD")
  lastCrawledAt                                          DateTime?
  inStock                                                Boolean                 @default(true)
  stockLevel                                             Int?
  createdAt                                              DateTime                @default(now())
  updatedAt                                              DateTime @updatedAt
  category                                               String?
  imageUrl                                               String?
  specifications                                         Json?
  brandId                                                String?
  categoryId                                             String?
  isManualPrice                                          Boolean                 @default(false)
  manualPrice                                            Decimal?                @db.Decimal(10, 2)
  manualPriceEnteredAt                                   DateTime?
  manualPriceEnteredBy                                   String?
  lastKnownGoodPrice                                     Decimal?                @db.Decimal(10, 2)
  lastKnownGoodPriceAt                                   DateTime?               @db.Timestamp(6)
  lastKnownGoodCurrency                                  String?                 @db.VarChar(10)
  PendingPriceChange                                     PendingPriceChange[]
  PriceHistory                                           PriceHistory[]
  PriceUpdateLog                                         PriceUpdateLog[]
  PriceUpdateRetryQueue                                  PriceUpdateRetryQueue[]
  Brand                                                  Brand?                  @relation(fields: [brandId], references: [id])
  Category                                               Category?               @relation(fields: [categoryId], references: [id])
  Site                                                   Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  Tenant                                                 Tenant                  @relation(fields: [tenantId], references: [id])
  matchesAsCompetitor                                    ProductMatch[]          @relation("ProductMatch_competitorProductIdToProduct")
  matchesAsUser                                          ProductMatch[]          @relation("ProductMatch_userProductIdToProduct")
  ScrapeAttempt                                          ScrapeAttempt[]
  ScrapeRetry                                            ScrapeRetry[]

  @@index([lastKnownGoodPriceAt], map: "idx_product_last_known_good_at")
  @@index([siteId])
  @@index([tenantId, brand])
  @@index([tenantId, category])
  @@index([tenantId, inStock])
  @@index([tenantId, currentPrice])
  @@index([sku])
  @@index([siteId, url])
  @@index([updatedAt])
}

model ProductMatch {
  id                String      @id @default(cuid())
  userProductId     String
  competitorProductId String
  matchType         MatchType   @default(AUTO_SKU)
  confidenceScore   Decimal     @db.Decimal(5, 2)
  createdAt         DateTime    @default(now())
  status            MatchStatus @default(PENDING)
  competitorProduct Product     @relation("ProductMatch_competitorProductIdToProduct", fields: [competitorProductId], references: [id], onDelete: Cascade)
  userProduct       Product     @relation("ProductMatch_userProductIdToProduct", fields: [userProductId], references: [id], onDelete: Cascade)

  @@unique([userProductId, competitorProductId])
  @@index([userProductId, status])
  @@index([competitorProductId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ProtectionDetection {
  id              String        @id @default(cuid())
  scrapeAttemptId String
  protectionType  String
  confidence      Decimal       @db.Decimal(5, 2)
  indicators      Json
  reasoning       String?
  createdAt       DateTime      @default(now())
  ScrapeAttempt   ScrapeAttempt @relation(fields: [scrapeAttemptId], references: [id], onDelete: Cascade)

  @@index([protectionType])
  @@index([scrapeAttemptId])
}

model Proxy {
  id                 String            @id @default(cuid())
  provider           String
  host               String
  port               Int
  protocol           String
  username           String?
  passwordEncrypted  String?
  region             String?
  status             String            @default("active")
  globalSuccessCount Int               @default(0)
  globalFailureCount Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime @updatedAt
  ProxySiteHealth    ProxySiteHealth[]
  ScrapeAttempt      ScrapeAttempt[]

  @@unique([host, port])
  @@index([status])
}

model ProxyHealth {
  id              String   @id @default(cuid())
  proxyUrl        String   @unique
  proxyType       String
  isHealthy       Boolean  @default(true)
  failureCount    Int      @default(0)
  successCount    Int      @default(0)
  avgResponseTime Float    @default(0)
  lastChecked     DateTime @default(now())
  lastSuccess     DateTime @default(now())

  @@index([isHealthy])
}

model ProxyMetrics {
  id                 String   @id @default(cuid())
  proxy              String
  timestamp          DateTime @default(now())
  totalRequests      Int
  successfulRequests Int
  failedRequests     Int
  avgResponseTime    Float
  successRate        Float

  @@index([proxy, timestamp])
}

model ProxySiteHealth {
  id                  String    @id @default(cuid())
  proxyId             String
  competitorWebsiteId String
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
