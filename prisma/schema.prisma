generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String        @id @default(uuid())
  companyName     String
  planType        PlanType      @default(BASIC)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  competitorLimit Int           @default(3)
  storeLimit      Int           @default(1)
  currency        String        @default("USD")
  pricingRules    PricingRule[]
  products        Product[]
  sites           Site[]
  users           User[]
  webhooks        Webhook[]
  auditLogs       TenantAuditLog[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt         DateTime          @updatedAt
  passwordUpdatedAt DateTime          @default(now())
  emailVerified     DateTime?
  verificationToken String?
  isSuperAdmin      Boolean           @default(false)
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  passwordHistory PasswordHistory[]
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Site {
  id             String       @id @default(uuid())
  tenantId       String
  type           SiteType
  platform       PlatformType @default(GENERIC)
  baseUrl        String
  apiToken       String?
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isSyncing      Boolean      @default(false)
  syncProcessed  Int          @default(0)
  syncStartedAt  DateTime?
  syncTotal      Int          @default(0)
  syncLastAction String?
  currency       String       @default("USD")
  products       Product[]
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  syncLogs       SyncLog[]
}

model SyncLog {
  id        String   @id @default(uuid())
  siteId    String
  message   String
  level     String   @default("INFO")
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Product {
  id                  String           @id @default(uuid())
  siteId              String
  tenantId            String
  externalId          String?
  sku                 String?
  url                 String?
  title               String
  brand               String?
  model               String?
  currentPrice        Decimal          @db.Decimal(10, 2)
  currency            String           @default("USD")
  lastCrawledAt       DateTime?
  inStock             Boolean          @default(true)
  stockLevel          Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  category            String?
  imageUrl            String?
  priceHistory        PriceHistory[]
  updateLogs          PriceUpdateLog[]
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  matchesAsCompetitor ProductMatch[]   @relation("CompetitorProduct")
  matchesAsUser       ProductMatch[]   @relation("UserProduct")

  @@index([sku])
  @@index([tenantId])
}

model ProductMatch {
  id                  String    @id @default(uuid())
  userProductId       String
  competitorProductId String
  matchType           MatchType @default(AUTO_SKU)
  confidenceScore     Decimal   @db.Decimal(5, 2)
  createdAt           DateTime  @default(now())
  competitorProduct   Product   @relation("CompetitorProduct", fields: [competitorProductId], references: [id], onDelete: Cascade)
  userProduct         Product   @relation("UserProduct", fields: [userProductId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceUpdateLog {
  id           String       @id @default(uuid())
  productId    String
  oldPrice     Decimal      @db.Decimal(10, 2)
  newPrice     Decimal      @db.Decimal(10, 2)
  logicType    LogicType
  status       UpdateStatus @default(SUCCESS)
  errorDetails String?
  executedAt   DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  strategy    StrategyType
  parameter   Decimal      @db.Decimal(10, 2)
  priority    Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TenantAuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  userEmail String
  action    String   // e.g., "APPROVE_MATCH", "REJECT_MATCH"
  entityId  String   // e.g., the match ID
  details   String?  // JSON string for extra info
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

enum PlanType {
  BASIC
  PREMIUM
  PRO
}

enum Role {
  ADMIN
  VIEWER
}

enum SiteType {
  USER
  COMPETITOR
}

enum PlatformType {
  OPENCART
  LARAVEL
  GENERIC
  SHOPIFY
  WOOCOMMERCE
  MAGENTO
  PRESTASHOP
  BIGCOMMERCE
}

enum MatchType {
  AUTO_SKU
  AUTO_MODEL
  MANUAL
}

enum LogicType {
  FIXED
  PERCENTAGE
}

enum UpdateStatus {
  SUCCESS
  FAILED
}

enum StrategyType {
  UNDERCUT
  MATCH
  MARGIN_LOCK
  THRESHOLD
  PERCENTAGE
  INVENTORY_HIKE
}
