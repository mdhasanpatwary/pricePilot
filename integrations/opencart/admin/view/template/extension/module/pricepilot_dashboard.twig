{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-refresh" class="btn btn-info" data-toggle="tooltip" title="Refresh Statistics"><i class="fa fa-refresh"></i> Refresh</button>
        <a href="{{ config_link }}" data-toggle="tooltip" title="Configuration" class="btn btn-default"><i class="fa fa-cog"></i> Configuration</a>
      </div>
      <h1><i class="fa fa-dashboard"></i> {{ heading_title }}</h1>
      <ul class="breadcrumb">
        <li><a href="{{ config_link }}">Configuration</a></li>
        <li><a href="{{ config_link }}/dashboard?user_token={{ user_token }}">Dashboard</a></li>
      </ul>
    </div>
  </div>
  
  <div class="container-fluid">
    <!-- Statistics Overview -->
    <div class="row">
      <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="panel panel-primary">
          <div class="panel-body">
            <div class="row">
              <div class="col-xs-3">
                <i class="fa fa-clock-o fa-5x"></i>
              </div>
              <div class="col-xs-9 text-right">
                <div class="huge">{{ last_sync }}</div>
                <div>Last Sync</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="panel panel-success">
          <div class="panel-body">
            <div class="row">
              <div class="col-xs-3">
                <i class="fa fa-shopping-cart fa-5x"></i>
              </div>
              <div class="col-xs-9 text-right">
                <div class="huge">{{ total_products }}</div>
                <div>Total Products</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="panel panel-warning">
          <div class="panel-body">
            <div class="row">
              <div class="col-xs-3">
                <i class="fa fa-edit fa-5x"></i>
              </div>
              <div class="col-xs-9 text-right">
                <div class="huge">{{ today_updates }}</div>
                <div>Today's Updates</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="panel panel-info">
          <div class="panel-body">
            <div class="row">
              <div class="col-xs-3">
                <i class="fa fa-tasks fa-5x"></i>
              </div>
              <div class="col-xs-9 text-right">
                <div class="huge">{{ api_stats.total_requests }}</div>
                <div>API Requests Today</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- API Usage Statistics -->
    <div class="row">
      <div class="col-lg-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-bar-chart"></i> API Usage Statistics (Today)</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-bordered">
                <tbody>
                  <tr>
                    <td><strong>Total Requests</strong></td>
                    <td class="text-right">{{ api_stats.total_requests }}</td>
                  </tr>
                  <tr class="success">
                    <td><strong>Successful Requests</strong></td>
                    <td class="text-right">{{ api_stats.success_count }}</td>
                  </tr>
                  <tr class="danger">
                    <td><strong>Failed Requests</strong></td>
                    <td class="text-right">{{ api_stats.error_count }}</td>
                  </tr>
                  <tr>
                    <td><strong>Average Response Time</strong></td>
                    <td class="text-right">{{ api_stats.avg_response_time }}s</td>
                  </tr>
                </tbody>
              </table>
            </div>
            
            {% if api_stats.by_endpoint %}
            <h4>Top Endpoints</h4>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Endpoint</th>
                    <th class="text-right">Requests</th>
                  </tr>
                </thead>
                <tbody>
                  {% for endpoint in api_stats.by_endpoint %}
                  <tr>
                    <td>{{ endpoint.endpoint }}</td>
                    <td class="text-right">{{ endpoint.count }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
            
            {% if api_stats.by_status %}
            <h4>Response Status Codes</h4>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Status Code</th>
                    <th class="text-right">Count</th>
                  </tr>
                </thead>
                <tbody>
                  {% for status in api_stats.by_status %}
                  <tr class="{% if status.response_code >= 200 and status.response_code < 300 %}success{% elseif status.response_code >= 400 %}danger{% endif %}">
                    <td>{{ status.response_code }}</td>
                    <td class="text-right">{{ status.count }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
      
      <div class="col-lg-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-pie-chart"></i> API Usage Chart</h3>
          </div>
          <div class="panel-body">
            <canvas id="apiUsageChart" width="400" height="300"></canvas>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Recent Price Changes -->
    <div class="row">
      <div class="col-lg-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-history"></i> Recent Price Changes (Last 10)</h3>
          </div>
          <div class="panel-body">
            {% if recent_changes %}
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>Product ID</th>
                    <th>Product Name</th>
                    <th class="text-right">Old Price</th>
                    <th class="text-right">New Price</th>
                    <th class="text-right">Change</th>
                    <th>Changed By</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  {% for change in recent_changes %}
                  <tr>
                    <td>{{ change.product_id }}</td>
                    <td>{{ change.product_name }}</td>
                    <td class="text-right">{{ change.old_price }}</td>
                    <td class="text-right">{{ change.new_price }}</td>
                    <td class="text-right">
                      {% set price_diff = change.new_price - change.old_price %}
                      {% if price_diff > 0 %}
                        <span class="text-success"><i class="fa fa-arrow-up"></i> +{{ price_diff|number_format(2) }}</span>
                      {% elseif price_diff < 0 %}
                        <span class="text-danger"><i class="fa fa-arrow-down"></i> {{ price_diff|number_format(2) }}</span>
                      {% else %}
                        <span class="text-muted">0.00</span>
                      {% endif %}
                    </td>
                    <td>{{ change.changed_by }}</td>
                    <td>{{ change.date_added }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <div class="text-right">
              <a href="index.php?route=extension/module/pricepilot/activityLog&user_token={{ user_token }}" class="btn btn-primary">
                <i class="fa fa-list"></i> View Full Activity Log
              </a>
            </div>
            {% else %}
            <div class="alert alert-info">
              <i class="fa fa-info-circle"></i> No price changes recorded yet.
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.huge {
  font-size: 40px;
  font-weight: bold;
}
.panel-body {
  min-height: 100px;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script type="text/javascript"><!--
// Refresh button functionality
$('#button-refresh').on('click', function() {
    location.reload();
});

// API Usage Chart
var ctx = document.getElementById('apiUsageChart').getContext('2d');
var apiUsageChart = new Chart(ctx, {
    type: 'doughnut',
    data: {
        labels: ['Successful', 'Failed'],
        datasets: [{
            data: [{{ api_stats.success_count }}, {{ api_stats.error_count }}],
            backgroundColor: [
                'rgba(92, 184, 92, 0.8)',
                'rgba(217, 83, 79, 0.8)'
            ],
            borderColor: [
                'rgba(92, 184, 92, 1)',
                'rgba(217, 83, 79, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: {
                position: 'bottom',
            },
            title: {
                display: true,
                text: 'Request Success Rate'
            }
        }
    }
});
//--></script>
{{ footer }}
