{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="Save" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="Cancel" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label">Module Status</label>
            <div class="col-sm-10">
              <select name="module_pricepilot_status" class="form-control">
                <option value="1" {% if module_pricepilot_status %}selected="selected"{% endif %}>Enabled</option>
                <option value="0" {% if not module_pricepilot_status %}selected="selected"{% endif %}>Disabled</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">API Token</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="module_pricepilot_token" value="{{ module_pricepilot_token }}" id="input-token" class="form-control" readonly />
                <span class="input-group-btn">
                  <button type="button" id="button-copy" class="btn btn-info" data-toggle="tooltip" title="Copy Token"><i class="fa fa-copy"></i> Copy</button>
                </span>
              </div>
              <small class="text-muted">Copy this token and paste it into your PricePilot Dashboard.</small>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
$('#button-copy').on('click', function() {
    var tokenInput = document.getElementById("input-token");
    tokenInput.select();
    tokenInput.setSelectionRange(0, 99999);
    document.execCommand("copy");
    
    var btn = $(this);
    var originalText = btn.html();
    btn.html('<i class="fa fa-check"></i> Copied!');
    btn.addClass('btn-success').removeClass('btn-info');
    
    setTimeout(function() {
        btn.html(originalText);
        btn.addClass('btn-info').removeClass('btn-success');
    }, 2000);
});
//--></script>
{{ footer }}
