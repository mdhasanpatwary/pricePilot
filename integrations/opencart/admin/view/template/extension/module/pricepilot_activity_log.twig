{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ export_link }}" data-toggle="tooltip" title="Export to CSV" class="btn btn-success"><i class="fa fa-download"></i> Export CSV</a>
        <a href="{{ dashboard_link }}" data-toggle="tooltip" title="Back to Dashboard" class="btn btn-default"><i class="fa fa-dashboard"></i> Dashboard</a>
        <a href="{{ config_link }}" data-toggle="tooltip" title="Configuration" class="btn btn-default"><i class="fa fa-cog"></i> Configuration</a>
      </div>
      <h1><i class="fa fa-history"></i> {{ heading_title }}</h1>
      <ul class="breadcrumb">
        <li><a href="{{ config_link }}">Configuration</a></li>
        <li><a href="{{ dashboard_link }}">Dashboard</a></li>
        <li>Activity Log</li>
      </ul>
    </div>
  </div>
  
  <div class="container-fluid">
    <!-- Filter Panel -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-filter"></i> Filter Activity Log</h3>
      </div>
      <div class="panel-body">
        <form action="{{ filter_action }}" method="get" id="form-filter">
          <input type="hidden" name="route" value="extension/module/pricepilot/activityLog" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          
          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="filter_product_id">Product ID</label>
                <input type="text" name="filter_product_id" id="filter_product_id" value="{{ filter_product_id }}" placeholder="Enter Product ID" class="form-control" />
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="form-group">
                <label for="filter_date_from">Date From</label>
                <input type="date" name="filter_date_from" id="filter_date_from" value="{{ filter_date_from }}" class="form-control" />
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="form-group">
                <label for="filter_date_to">Date To</label>
                <input type="date" name="filter_date_to" id="filter_date_to" value="{{ filter_date_to }}" class="form-control" />
              </div>
            </div>
            
            <div class="col-md-3">
              <div class="form-group">
                <label for="filter_changed_by">Changed By</label>
                <select name="filter_changed_by" id="filter_changed_by" class="form-control">
                  <option value="">All Sources</option>
                  <option value="API" {% if filter_changed_by == 'API' %}selected{% endif %}>API</option>
                  <option value="Admin" {% if filter_changed_by == 'Admin' %}selected{% endif %}>Admin</option>
                  <option value="System" {% if filter_changed_by == 'System' %}selected{% endif %}>System</option>
                </select>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-12 text-right">
              <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Filter</button>
              <button type="button" id="button-clear" class="btn btn-default"><i class="fa fa-times"></i> Clear</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Activity Log Table -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> Price Change History</h3>
      </div>
      <div class="panel-body">
        {% if logs %}
        <div class="table-responsive">
          <table class="table table-striped table-hover table-bordered" id="activity-log-table">
            <thead>
              <tr>
                <th class="text-center">Log ID</th>
                <th class="text-center">Product ID</th>
                <th>Product Name</th>
                <th class="text-right">Old Price</th>
                <th class="text-right">New Price</th>
                <th class="text-right">Change</th>
                <th class="text-center">Changed By</th>
                <th class="text-center">Store ID</th>
                <th class="text-center">Date</th>
              </tr>
            </thead>
            <tbody>
              {% for log in logs %}
              <tr>
                <td class="text-center">{{ log.log_id }}</td>
                <td class="text-center">{{ log.product_id }}</td>
                <td>{{ log.product_name }}</td>
                <td class="text-right">{{ log.old_price|number_format(2) }}</td>
                <td class="text-right">{{ log.new_price|number_format(2) }}</td>
                <td class="text-right">
                  {% set price_diff = log.new_price - log.old_price %}
                  {% if price_diff > 0 %}
                    <span class="text-success"><i class="fa fa-arrow-up"></i> +{{ price_diff|number_format(2) }}</span>
                  {% elseif price_diff < 0 %}
                    <span class="text-danger"><i class="fa fa-arrow-down"></i> {{ price_diff|number_format(2) }}</span>
                  {% else %}
                    <span class="text-muted">0.00</span>
                  {% endif %}
                </td>
                <td class="text-center">
                  {% if log.changed_by == 'API' %}
                    <span class="label label-primary">{{ log.changed_by }}</span>
                  {% elseif log.changed_by == 'Admin' %}
                    <span class="label label-info">{{ log.changed_by }}</span>
                  {% else %}
                    <span class="label label-default">{{ log.changed_by }}</span>
                  {% endif %}
                </td>
                <td class="text-center">{{ log.store_id }}</td>
                <td class="text-center">{{ log.date_added }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <div class="row">
          <div class="col-sm-6 text-left">
            {{ results }}
          </div>
          <div class="col-sm-6 text-right">
            {{ pagination }}
          </div>
        </div>
        {% else %}
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i> No activity log entries found matching your filters.
        </div>
        {% endif %}
      </div>
    </div>
    
    <!-- Statistics Summary -->
    {% if logs %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Summary Statistics</h3>
      </div>
      <div class="panel-body">
        <div class="row">
          <div class="col-md-4">
            <div class="well text-center">
              <h4>Total Entries</h4>
              <p class="lead">{{ total }}</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="well text-center">
              <h4>Current Page</h4>
              <p class="lead">{{ logs|length }}</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="well text-center">
              <h4>Export Available</h4>
              <p class="lead"><a href="{{ export_link }}" class="btn btn-success btn-sm"><i class="fa fa-download"></i> Download CSV</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>

<style>
#activity-log-table th {
  background-color: #f5f5f5;
  font-weight: bold;
}
#activity-log-table tbody tr:hover {
  background-color: #f9f9f9;
}
.well {
  margin-bottom: 0;
}
</style>

<script type="text/javascript"><!--
// Clear filters button
$('#button-clear').on('click', function() {
    window.location = 'index.php?route=extension/module/pricepilot/activityLog&user_token={{ user_token }}';
});

// Enable tooltips
$('[data-toggle="tooltip"]').tooltip();

// Table sorting (optional enhancement)
$(document).ready(function() {
    // Add sorting capability to table headers
    $('#activity-log-table th').css('cursor', 'pointer');
});
//--></script>
{{ footer }}
