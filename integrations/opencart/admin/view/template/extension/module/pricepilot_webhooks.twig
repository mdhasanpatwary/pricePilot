{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add_webhook_link }}" data-toggle="tooltip" title="Add New Webhook" class="btn btn-primary"><i class="fa fa-plus"></i> Add Webhook</a>
        <a href="{{ dashboard_link }}" data-toggle="tooltip" title="Back to Dashboard" class="btn btn-default"><i class="fa fa-dashboard"></i> Dashboard</a>
        <a href="{{ config_link }}" data-toggle="tooltip" title="Configuration" class="btn btn-default"><i class="fa fa-cog"></i> Configuration</a>
      </div>
      <h1><i class="fa fa-bell"></i> {{ heading_title }}</h1>
      <ul class="breadcrumb">
        <li><a href="{{ config_link }}">Configuration</a></li>
        <li><a href="{{ dashboard_link }}">Dashboard</a></li>
        <li>Webhooks</li>
      </ul>
    </div>
  </div>
  
  <div class="container-fluid">
    <!-- Success/Error Messages -->
    {% if success %}
    <div class="alert alert-success alert-dismissible">
      <button type="button" class="close" data-dismiss="alert">&times;</button>
      <i class="fa fa-check-circle"></i> {{ success }}
    </div>
    {% endif %}
    
    {% if error %}
    <div class="alert alert-danger alert-dismissible">
      <button type="button" class="close" data-dismiss="alert">&times;</button>
      <i class="fa fa-exclamation-circle"></i> {{ error }}
    </div>
    {% endif %}
    
    <!-- Webhooks Table -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> Configured Webhooks</h3>
      </div>
      <div class="panel-body">
        {% if webhooks %}
        <div class="table-responsive">
          <table class="table table-striped table-hover table-bordered" id="webhooks-table">
            <thead>
              <tr>
                <th class="text-center" style="width: 80px;">ID</th>
                <th>Webhook URL</th>
                <th class="text-center" style="width: 250px;">Subscribed Events</th>
                <th class="text-center" style="width: 100px;">Status</th>
                <th class="text-center" style="width: 150px;">Date Added</th>
                <th class="text-center" style="width: 150px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for webhook in webhooks %}
              <tr>
                <td class="text-center">{{ webhook.webhook_id }}</td>
                <td>
                  <div style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ webhook.url }}">
                    <i class="fa fa-link"></i> {{ webhook.url }}
                  </div>
                </td>
                <td class="text-center">
                  {% for event in webhook.events %}
                    {% if event == 'product.created' %}
                      <span class="label label-success" style="margin: 2px;">Product Created</span>
                    {% elseif event == 'product.updated' %}
                      <span class="label label-info" style="margin: 2px;">Product Updated</span>
                    {% elseif event == 'product.deleted' %}
                      <span class="label label-danger" style="margin: 2px;">Product Deleted</span>
                    {% elseif event == 'price.changed' %}
                      <span class="label label-warning" style="margin: 2px;">Price Changed</span>
                    {% else %}
                      <span class="label label-default" style="margin: 2px;">{{ event }}</span>
                    {% endif %}
                  {% endfor %}
                </td>
                <td class="text-center">
                  {% if webhook.status == 1 %}
                    <span class="label label-success"><i class="fa fa-check"></i> Active</span>
                  {% else %}
                    <span class="label label-default"><i class="fa fa-times"></i> Inactive</span>
                  {% endif %}
                </td>
                <td class="text-center">{{ webhook.date_added }}</td>
                <td class="text-center">
                  <div class="btn-group">
                    <a href="{{ webhook.edit_link }}" data-toggle="tooltip" title="Edit Webhook" class="btn btn-primary btn-sm">
                      <i class="fa fa-pencil"></i>
                    </a>
                    <button type="button" data-toggle="tooltip" title="Delete Webhook" class="btn btn-danger btn-sm" onclick="confirmDelete('{{ webhook.delete_link }}', '{{ webhook.url }}')">
                      <i class="fa fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i> No webhooks configured yet. Click "Add Webhook" to create your first webhook.
        </div>
        {% endif %}
      </div>
    </div>
    
    <!-- Information Panel -->
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-info-circle"></i> About Webhooks</h3>
      </div>
      <div class="panel-body">
        <p><strong>Webhooks</strong> allow PricePilot to send real-time notifications to your external systems when product events occur.</p>
        
        <h4>Supported Events:</h4>
        <ul>
          <li><strong>Product Created:</strong> Triggered when a new product is added to your store</li>
          <li><strong>Product Updated:</strong> Triggered when product data is modified</li>
          <li><strong>Product Deleted:</strong> Triggered when a product is removed from your store</li>
          <li><strong>Price Changed:</strong> Triggered when a product price is updated via API</li>
        </ul>
        
        <h4>Webhook Payload:</h4>
        <p>Each webhook request includes:</p>
        <ul>
          <li>Event type and timestamp</li>
          <li>Store ID</li>
          <li>Event-specific data (product details, price changes, etc.)</li>
          <li>HMAC signature in <code>X-PricePilot-Signature</code> header for verification</li>
        </ul>
        
        <h4>Delivery & Retry:</h4>
        <ul>
          <li>Webhooks are delivered with a 5-second timeout</li>
          <li>Failed deliveries are automatically retried up to 3 times with exponential backoff</li>
          <li>Failed webhooks are logged for admin review</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
#webhooks-table th {
  background-color: #f5f5f5;
  font-weight: bold;
}
#webhooks-table tbody tr:hover {
  background-color: #f9f9f9;
}
.label {
  display: inline-block;
  font-size: 11px;
}
</style>

<script type="text/javascript"><!--
// Confirm delete with webhook URL
function confirmDelete(deleteUrl, webhookUrl) {
    if (confirm('Are you sure you want to delete this webhook?\n\nURL: ' + webhookUrl + '\n\nThis action cannot be undone.')) {
        window.location = deleteUrl;
    }
}

// Enable tooltips
$('[data-toggle="tooltip"]').tooltip();

// Auto-dismiss alerts after 5 seconds
setTimeout(function() {
    $('.alert-dismissible').fadeOut('slow');
}, 5000);
//--></script>
{{ footer }}
