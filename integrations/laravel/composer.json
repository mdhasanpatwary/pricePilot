{
    "name": "pricepilot/laravel-client",
    "description": "Official Laravel integration package for PricePilot - Automated competitive pricing for e-commerce",
    "keywords": ["laravel", "pricepilot", "pricing", "e-commerce", "automation"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PricePilot Team",
            "email": "support@pricepilot.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/routing": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "PricePilot\\LaravelClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PricePilot\\LaravelClient\\PricePilotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
