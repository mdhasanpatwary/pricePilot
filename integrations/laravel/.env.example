# PricePilot Laravel Integration - Example Environment Variables

# ============================================
# REQUIRED: PricePilot API Token
# ============================================
# Generate a secure random token for authentication
# Use one of these methods:
# - openssl rand -base64 32
# - php -r "echo bin2hex(random_bytes(32));"
# - php artisan tinker >>> Str::random(64)

PRICEPILOT_API_TOKEN=your-secure-random-token-here

# ============================================
# OPTIONAL: Route Configuration
# ============================================
# Customize the API route prefix
# Default: api/pricepilot

# PRICEPILOT_ROUTE_PREFIX=api/pricepilot

# ============================================
# OPTIONAL: Database Configuration
# ============================================
# Customize table and column names to match your database

# Products table name
# PRICEPILOT_PRODUCTS_TABLE=products

# Column mappings
# PRICEPILOT_COL_ID=id
# PRICEPILOT_COL_NAME=name
# PRICEPILOT_COL_SKU=sku
# PRICEPILOT_COL_PRICE=price
# PRICEPILOT_COL_BRAND=brand
# PRICEPILOT_COL_MODEL=model

# Filter by active/published products only
# Set to the column name that indicates if a product is active
# Leave commented to sync all products
# PRICEPILOT_ACTIVE_COLUMN=is_active

# ============================================
# OPTIONAL: Feature Toggles
# ============================================

# Enable detailed logging
# PRICEPILOT_ENABLE_LOGGING=true

# Fire Laravel events on price updates
# PRICEPILOT_FIRE_EVENTS=true
